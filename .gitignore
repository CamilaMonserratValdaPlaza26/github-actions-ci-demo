# Logs
# ES: registros (logs)
logs
# ES: carpeta/archivo de logs
*.log
# ES: cualquier archivo .log
npm-debug.log*
# ES: logs de depuracion de npm
yarn-debug.log*
# ES: logs de depuracion de yarn
yarn-error.log*
# ES: logs de errores de yarn
lerna-debug.log*
# ES: logs de errores de lerna

# Diagnostic reports (https://nodejs.org/api/report.html)
# ES: informes de diagnostico de Node
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
# ES: informes de diagnostico con fecha

# Runtime data
# ES: datos en tiempo de ejecucion
pids
# ES: archivos de procesos
*.pid
# ES: archivos de identificador de proceso
*.seed
# ES: archivos semilla
*.pid.lock
# ES: bloqueos de procesos

# Directory for instrumented libs generated by jscoverage/JSCover
# ES: directorio de librerias instrumentadas
lib-cov
# ES: cobertura de librerias

# Coverage directory used by tools like istanbul
# ES: directorio de cobertura de pruebas
coverage
# ES: carpeta de cobertura
*.lcov
# ES: archivos de cobertura lcov

# nyc test coverage
# ES: cobertura de pruebas con nyc
.nyc_output
# ES: salida de nyc

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
# ES: almacenamiento temporal de Grunt
.grunt
# ES: carpeta de Grunt

# Bower dependency directory (https://bower.io/)
# ES: directorio de dependencias de Bower
bower_components
# ES: carpeta de Bower

# node-waf configuration
# ES: configuracion de node-waf
.lock-wscript
# ES: archivo de bloqueo de node-waf

# Compiled binary addons (https://nodejs.org/api/addons.html)
# ES: complementos binarios compilados
build/Release
# ES: binarios compilados

# Dependency directories
# ES: directorios de dependencias
node_modules/
# ES: dependencias de npm (no se suben)
jspm_packages/
# ES: dependencias de jspm

# Snowpack dependency directory (https://snowpack.dev/)
# ES: directorio de dependencias de Snowpack
web_modules/
# ES: modulos de Snowpack

# TypeScript cache
# ES: cache de TypeScript
*.tsbuildinfo
# ES: cache de compilacion de TypeScript

# Optional npm cache directory
# ES: cache opcional de npm
.npm
# ES: carpeta de cache de npm

# Optional eslint cache
# ES: cache opcional de ESLint
.eslintcache
# ES: cache de ESLint

# Optional stylelint cache
# ES: cache opcional de stylelint
.stylelintcache
# ES: cache de stylelint

# Optional REPL history
# ES: historial opcional de REPL
.node_repl_history
# ES: historial de Node

# Output of 'npm pack'
# ES: salida de npm pack
*.tgz
# ES: paquetes comprimidos .tgz

# Yarn Integrity file
# ES: archivo de integridad de Yarn
.yarn-integrity
# ES: integridad de Yarn

# dotenv environment variable files
# ES: archivos de variables de entorno
.env
# ES: variables de entorno (no se sube)
.env.*
# ES: variantes de .env
!.env.example
# ES: excepcion: si se sube .env.example

# parcel-bundler cache (https://parceljs.org/)
# ES: cache de Parcel
.cache
# ES: cache de Parcel
.parcel-cache
# ES: cache de Parcel

# Next.js build output
# ES: salida de compilacion de Next.js
.next
# ES: build de Next.js
out
# ES: carpeta de salida

# Nuxt.js build / generate output
# ES: salida de compilacion de Nuxt.js
.nuxt
# ES: build de Nuxt
dist
# ES: carpeta dist
.output
# ES: carpeta de salida

# Gatsby files
# ES: archivos de Gatsby
.cache/
# ES: cache de Gatsby
# Comment in the public line in your project uses Gatsby and not Next.js
# ES: comentario: activar la linea public si usas Gatsby
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
# ES: salida de compilacion de VuePress
.vuepress/dist
# ES: build de VuePress

# vuepress v2.x temp directory
# ES: directorio temporal de VuePress v2
.temp
# ES: archivos temporales

# Sveltekit cache directory
# ES: cache de SvelteKit
.svelte-kit/
# ES: carpeta de SvelteKit

# vitepress build output
# ES: salida de compilacion de VitePress
**/.vitepress/dist
# ES: build de VitePress

# vitepress cache directory
# ES: cache de VitePress
**/.vitepress/cache
# ES: cache de VitePress

# Docusaurus cache and generated files
# ES: cache y archivos generados de Docusaurus
.docusaurus
# ES: carpeta de Docusaurus

# Serverless directories
# ES: directorios de Serverless
.serverless/
# ES: carpeta de Serverless

# FuseBox cache
# ES: cache de FuseBox
.fusebox/
# ES: carpeta de FuseBox

# DynamoDB Local files
# ES: archivos de DynamoDB Local
.dynamodb/
# ES: datos de DynamoDB Local

# Firebase cache directory
# ES: cache de Firebase
.firebase/
# ES: carpeta de Firebase

# TernJS port file
# ES: archivo de puerto de TernJS
.tern-port
# ES: puerto de TernJS

# Stores Visual Studio Code versions used for testing Visual Studio Code extensions
# ES: versiones de VS Code usadas para probar extensiones
.vscode-test
# ES: carpeta de pruebas de VS Code

# pnpm
# ES: archivos de pnpm
.pnpm-store
# ES: almacen de pnpm

# yarn v3
# ES: archivos de Yarn v3
.pnp.*
# ES: archivos Plug'n'Play
.yarn/*
# ES: contenido de la carpeta .yarn
!.yarn/patches
# ES: excepcion: parches de Yarn
!.yarn/plugins
# ES: excepcion: plugins de Yarn
!.yarn/releases
# ES: excepcion: releases de Yarn
!.yarn/sdks
# ES: excepcion: sdks de Yarn
!.yarn/versions
# ES: excepcion: versiones de Yarn

# Vite files
# ES: archivos de Vite
vite.config.js.timestamp-*
# ES: temporales de configuracion Vite
vite.config.ts.timestamp-*
# ES: temporales de configuracion Vite
.vite/
# ES: cache de Vite

# Astro generated types
# ES: tipos generados por Astro
.astro/
# ES: cache de Astro

# Turbo Repo
# ES: cache de Turbo Repo
.turbo
# ES: carpeta de Turbo
